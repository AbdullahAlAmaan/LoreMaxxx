# ============================================
# Backend — copy to backend/.env
# ============================================

# Database (Docker Compose defaults)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lifemax
DB_USER=lifemax
DB_PASSWORD=lifemax_dev_2024

# Server
PORT=3001

# JWT — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your-jwt-secret-change-in-production

# CORS — set to your mobile/web origin in production; leave '*' for local dev
CORS_ORIGIN=*

# Check-in radius in meters
CHECKIN_RADIUS_METERS=100

# ============================================
# Mobile — copy to mobile/.env
# ============================================

# Backend URL (EXPO_PUBLIC_ prefix is required for Expo to expose this to the app)
#   iOS simulator / web:  http://localhost:3001
#   Android emulator:     http://10.0.2.2:3001
#   Physical device:      http://<your-local-ip>:3001
#   Production:           https://your-api.example.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# Mapbox public access token (pk.*) — from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
