{
  "expo": {
    "name": "LoreMaxxx",
    "slug": "loremaxxx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1123"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loremaxxx.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1123"
      },
      "package": "com.loremaxxx.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@rnmapbox/maps"
    ],
    "extra": {
      "mapboxToken": "pk.your_public_access_token_here"
    }
  }
}
